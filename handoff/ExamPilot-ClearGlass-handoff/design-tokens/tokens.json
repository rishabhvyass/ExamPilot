    "recess": { "background": "linear-gradient(180deg,#DEDEE1,#E9E9EB)", "shadow": "inset 0 2px 6px rgba(0,0,0,.13), inset 0 -1px 0 rgba(255,255,255,.9)" },
    "dock":   { "background": "linear-gradient(180deg,#FFFFFF,#F0F0F2)", "shadow": "inset 0 1px 0 #FFFFFF, 0 0 0 1px rgba(0,0,0,.05), 0 2px 4px rgba(0,0,0,.05), 0 16px 34px rgba(0,0,0,.10)" },
    "inkGloss": { "background": "linear-gradient(180deg,#4A4A4F 0%,#1C1C1F 55%,#0E0E10 100%)", "shadow": "inset 0 1px 0 rgba(255,255,255,.22), inset 0 -1px 0 rgba(0,0,0,.4), 0 1px 2px rgba(0,0,0,.25), 0 8px 18px rgba(0,0,0,.18)" },
    "glassPanel": { "background": "linear-gradient(160deg,rgba(255,255,255,.78),rgba(248,250,253,.55))", "backdropFilter": "blur(22px) saturate(1.6)", "shadow": "inset 0 1px 0 #FFFFFF, inset 0 0 0 1px rgba(15,23,42,.07), 0 14px 36px rgba(15,23,42,.07)" },
    "sheen": { "overlay": "linear-gradient(160deg,rgba(255,255,255,.6),rgba(255,255,255,0) 55%)", "shadow": "inset 0 1px 0 rgba(255,255,255,.9), inset 0 0 0 1px rgba(255,255,255,.6), 0 12px 30px rgba(15,23,42,.06)" }
  },
  "radius": { "input": 22, "panel": 28, "card": 34, "sheet": 36, "reader": 40, "pill": 9999 },
  "size": { "primaryButton": [62, 64], "arrowChip": [46, 48], "iconButton": 56, "iconButtonSmall": [44, 48], "chip": 52, "tab": 56, "touchMin": 44 },
  "type": [
    { "name": "splash", "size": 60, "lineHeight": 1.0, "weight": 600, "tracking": "-0.04em" },
    { "name": "display", "size": 46, "lineHeight": 1.02, "weight": 600, "tracking": "-0.03em" },
    { "name": "onboardTitle", "size": 40, "lineHeight": 1.05, "weight": 600, "tracking": "-0.03em" },
    { "name": "stat", "size": 54, "lineHeight": 1.0, "weight": 600, "tracking": "-0.03em" },
    { "name": "cardTitle", "size": 28, "lineHeight": 1.1, "weight": 600, "tracking": "-0.02em" },
    { "name": "section", "size": 24, "lineHeight": 1.2, "weight": 600, "tracking": "-0.02em" },
