    "subjects": {
      "SE":  { "name": "Software Engineering", "fill": "#DCEBFF", "deep": "#BFD6FF", "text": "#1E3A8A", "mark": "#2563EB" },
      "DAA": { "name": "Design and Analysis of Algorithm", "fill": "#EDE5FF", "deep": "#CDBBFF", "text": "#5B21B6", "mark": "#7C3AED" },
      "DDS": { "name": "Design of Data Structures", "fill": "#D9F5E6", "deep": "#9EE6C0", "text": "#065F46", "mark": "#10B981" }
    },
    "art": { "blue": "#3B82F6", "violet": "#DDD0FF", "green": "#BBF0D3", "pink": "#F9A8D4" },
