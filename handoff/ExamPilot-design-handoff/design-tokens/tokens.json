{
  "name": "ExamPilot — Lavender Calm",
  "color": {
    "ground": "#EDECE8",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F4F2EE",
    "surfaceInput": "#F7F6F3",
    "ink": "#1B1B1F",
    "inkMuted": "#5C5866",
    "inkSubtle": "#77727F",
    "border": "#E4E1DA",
    "borderStrong": "#CFCAC1",
    "track": "#ECEAE5",
    "splash": "#C9C0DB",
    "onInk": "#FFFFFF",
    "subject": {
      "se":  { "fill": "#D6CDE6", "fillDeep": "#C5BADB", "text": "#3E3557", "textMuted": "#4A4260", "mark": "#7D6BAA", "art": "#8C7BB5" },
      "daa": { "fill": "#EBD3D7", "fillDeep": "#DDB5BD", "text": "#6B3440", "textMuted": "#6B3440", "mark": "#B86A7A", "art": "#C98A96" },
      "dds": { "fill": "#CFE6E0", "fillDeep": "#A9D3C8", "text": "#24524A", "textMuted": "#24524A", "mark": "#4F9686", "art": "#6FAFA2" }
    },
    "accent": { "pink": "#E9C4CC", "mint": "#BFE0D8", "lavenderLight": "#E9DFF7" },
    "status": {
      "info":    { "fill": "#E3EEF8", "text": "#2C5577" },
      "success": { "fill": "#CFE6E0", "text": "#24524A" },
      "headsUp": { "fill": "#FEF3DC", "text": "#7A5300" },
      "error":   { "fill": "#FDE7E4", "text": "#9A3B33", "note": "Real errors only. Never for deadlines or exams." }
    },
    "focusRing": "#1B1B1F"
  },
  "contrast": {
    "ink/ground": 14.5, "inkMuted/ground": 5.8, "inkSubtle/surface": 4.7,
    "se.text/se.fill": 7.4, "daa.text/daa.fill": 6.8, "dds.text/dds.fill": 6.7,
    "se.mark/surface": 4.6, "daa.mark/surface": 3.9, "dds.mark/surface": 3.5,
    "onInk/ink": 17.2
  },
  "font": {
    "family": "Urbanist, system-ui, sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "type": {
    "splashDisplay": { "size": 60, "lineHeight": 1.0, "weight": 600, "tracking": "-0.04em" },
    "display":       { "size": 46, "lineHeight": 1.02, "weight": 600, "tracking": "-0.03em" },
    "onboardTitle":  { "size": 40, "lineHeight": 1.05, "weight": 600, "tracking": "-0.03em" },
    "statNumber":    { "size": 54, "lineHeight": 1.0, "weight": 600, "tracking": "-0.03em" },
    "cardTitle":     { "size": 28, "lineHeight": 1.1, "weight": 600, "tracking": "-0.02em" },
    "sectionTitle":  { "size": 24, "lineHeight": 1.2, "weight": 600, "tracking": "-0.02em" },
    "eyebrow":       { "size": 20, "lineHeight": 1.3, "weight": 500 },
    "bodyLarge":     { "size": 17, "lineHeight": 1.5, "weight": 500 },
    "body":          { "size": 16, "lineHeight": 1.55, "weight": 400 },
    "caption":       { "size": 14, "lineHeight": 1.45, "weight": 400 },
    "micro":         { "size": 13, "lineHeight": 1.4, "weight": 600 }
  },
  "radius": { "input": 22, "inset": 22, "panel": 28, "card": 34, "sheet": 36, "phone": 44, "pill": 9999 },
  "size": { "iconButton": 56, "iconButtonSmall": 44, "primaryButtonHeight": 62, "chipHeight": 52, "navHeight": 72, "minTouch": 44, "icon": 22 },
  "space": { "base": 4, "screenGutter": 20, "onboardGutter": 24, "cardPadding": 20, "cardGap": 14, "sectionGap": 24, "screenTop": 60, "bottomSafe": 128 },
  "shadow": {
    "card": "0 1px 2px rgba(60,45,20,0.04), 0 6px 20px rgba(60,45,20,0.05)",
    "nav": "0 12px 32px rgba(40,30,60,0.14)",
    "sheet": "0 2px 4px rgba(60,45,20,0.05), 0 16px 40px rgba(60,45,20,0.10)",
    "fab": "0 10px 26px rgba(27,27,31,0.25)"
  },
  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "smooth": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "overshoot": "cubic-bezier(0.2, 0.9, 0.25, 1.05)",
      "bouncy": "cubic-bezier(0.2, 0.9, 0.25, 1.25)"
    },
    "duration": { "press": 120, "fast": 160, "toggle": 220, "enter": 260, "page": 360, "tabPill": 520, "splashTotal": 1900 },
    "spring": { "press": { "stiffness": 500, "damping": 30 }, "layout": { "stiffness": 400, "damping": 34 }, "progress": { "stiffness": 300, "damping": 30 } }
  }
}
